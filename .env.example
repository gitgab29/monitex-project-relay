# Project Relay - configuration surface.
# Copy to .env and fill in the secrets.  .env is gitignored and must never be committed.
# Every value below has a working default in relay/config.py; this file documents them all.

# ---------------------------------------------------------------- site & source
SITE_ID=site-118                 # Written onto every event. Unset it on purpose to demo the
                                 # 'missing_site_id' review trigger.
CAMERA_INDEX=1                   # Webcam index for --source webcam. Two cams here: index 1 was
                                 # brighter (luma 125 vs 75) and gave no spurious boxes. Try 0 then 1.
FRAME_WIDTH=1280                 # Requested capture size. The camera may ignore it.
FRAME_HEIGHT=720
NOMINAL_FPS=30.0                 # Fallback when the source reports 0 fps. video_ts = frame_index / fps.

# ---------------------------------------------------------------- sampling
ANALYZE_FPS=1.0                  # Analyse every round(fps/ANALYZE_FPS) frames. Frame-INDEX based,
                                 # not wall-clock, so a live run and its replay analyse identical frames.
HEARTBEAT_S=5.0                  # Force an analysis if the last one was longer ago than this, even
                                 # when the motion gate says quiet. Absence produces no motion.
MOTION_THRESHOLD=4.0             # Mean abs grayscale diff (0-255) vs the last ANALYSED frame, at
                                 # 160x90 with a 5x5 blur. Below this the frame is skipped as quiet.
                                 # Sensor noise ~1-2, seated shift ~5-10, walking 15+.

# ---------------------------------------------------------------- zones
POST_ZONE=0.15,0.35,0.85,1.00    # Normalised x0,y0,x1,y1 rectangle = the guard post (foreground).
                                 # Everything outside it is the approach zone.
ZONE_MARGIN=0.04                 # Bbox centre within this distance of a post edge -> straddle=true,
                                 # decided by area instead, and flagged for review.
POST_MIN_AREA=0.10               # Straddle tie-break: area_frac >= this counts as inside the post.

# ---------------------------------------------------------------- detector
YOLO_MODEL=yolov8n.pt            # Auto-downloaded on first run. CPU-only here (~80-150 ms/frame).
YOLO_CONF=0.30                   # Low enough to hold a seated, half-occluded person.
YOLO_IMGSZ=640

# ---------------------------------------------------------------- state machine
MANNED_CONFIRM_FRAMES=2          # Consecutive analysed frames before MANNED is believed.
INTRUSION_CONFIRM_FRAMES=2       # Same, for >=2 people in the post zone.
UNATTENDED_DWELL_S=8.0           # Empty post for this long -> post_unattended. Production: 60-120.
LOITER_DWELL_S=6.0               # Person in the approach zone this long -> loitering.
EXIT_GRACE_S=3.0                 # Stops a state flapping when YOLO misses a frame.

# ---------------------------------------------------------------- event identity
EVENT_BUCKET_S=5                 # bucket = first_seen_ms // (EVENT_BUCKET_S*1000)
                                 # event_id = sha256(session_id|track_key|bucket)[:16]
DEDUPE_WINDOW_S=5.0              # Drift guard: an existing event with the same (session, track_key)
                                 # whose first_seen is within this window is reused, not re-minted.

# ---------------------------------------------------------------- human review
REVIEW_CONF_THRESHOLD=0.75       # Default: below this -> needs_review.
REVIEW_CONF_OTHER=0.85           # Stricter for category 'other' - the catch-all we trust least.
REVIEW_CONF_HIGH=0.90            # Strictest for any high-priority event: a false page wakes someone.

# ---------------------------------------------------------------- vision (stage 2)
VISION_BACKEND=gemini            # gemini | fake | none.  'none' = keyless: template summaries only.
# From aistudio.google.com, personal account, free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
VISION_TIMEOUT_S=12.0            # Hard per-call ceiling, enforced by us, not only by the SDK.
VISION_MIN_INTERVAL_S=4.0        # Client-side rate limiter. Raise it if AI Studio shows a low RPM.
VISION_JPEG_QUALITY=80
VISION_MAX_WIDTH=960             # Key frames are downscaled before upload.

# ---------------------------------------------------------------- reliability
RETRY_ATTEMPTS=3                 # delay = min(RETRY_CAP_S, RETRY_BASE_S * 2**n) + jitter(0, 0.5)
RETRY_BASE_S=1.0
RETRY_CAP_S=8.0

# ---------------------------------------------------------------- sinks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/relay-event
N8N_TIMEOUT_S=10.0
SMTP_HOST=smtp.gmail.com         # Direct-email fallback when n8n is down.
SMTP_PORT=587                    # STARTTLS.
# your gmail address
SMTP_USER=
# 16-char Google app password, NOT the account password
SMTP_APP_PASSWORD=
# where alerts land
ALERT_TO=
# optional Discord / webhook.site URL if Gmail is blocked
WEBHOOK_FALLBACK_URL=
SHEETS_ENABLED=false             # stretch goal, off by default

# ---------------------------------------------------------------- local API
API_HOST=0.0.0.0                 # 0.0.0.0 so the n8n container can reach it.
API_PORT=8080
API_BASE=http://host.docker.internal:8080   # What n8n calls back on. Use http://localhost:8080
                                            # instead when running n8n via `npx n8n` on the host.
REVIEW_LINK_BASE=http://localhost:8080      # What goes in the email a human clicks.

# ---------------------------------------------------------------- storage
DATA_DIR=data
DB_PATH=data/relay.db
LOG_LEVEL=INFO
